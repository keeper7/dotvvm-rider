@viewModel SampleApp.ViewModels.DifferentlyNamedViewModel, SampleApp
@import SampleApp.Resources

<!DOCTYPE html>
<html>
<head><title>Sample</title></head>
<body>
    <dot:TextBox Text="{value: Name}" />
    <%-- The `>` inside the binding would end the tag in plain HTML. DotVVM's own tokenizer
         accepts it, which is why the scanner has to as well. An anonymous type used to stand
         here too, and DotVVM does not compile that at all: the binding ends at its first `}`. --%>
    <dot:Repeater DataSource="{value: Items.Where(x => x.Id > 0)}">
        <ItemTemplate>
            <span>{{value: Name}}</span>
        </ItemTemplate>
    </dot:Repeater>
    <dot:Literal Class-required="{value: true}" Text="{value: Name}" />
    <dot:Button Text="{resource: Labels.Save}" Click="{command: Save()}" />
    <%-- Braces inside a string literal: the case a regex-based scanner got wrong, since the
         closing one is not the end of the binding. --%>
    <span>{{value: Name + "}"}}</span>
    <span>{{value: string.Format("{0}", Name)}}</span>
    <cc:MyControl Value="{value: Name}" />
    <div class="not-a-binding">{ this is not a binding }</div>

    <%-- The &quot; entities inside onclick are valid HTML, and the JavaScript the platform
         injects there is reported as broken - `&` and `quot` reach the JS parser undecoded.
         It happens the same way in a plain .html file, so it is not ours to fix; the line is
         kept as the evidence. --%>
    <button type="button" onclick="document.querySelector(&quot;#menu&quot;).classList.toggle(&quot;open&quot;)">Toggle</button>

    <%-- A whole element switched off. The tag inside must not be validated. --%>
    <table>
        <tr>
            <th <%-- width="30%" --%>>{{resource: Labels.Save}}</th>
            <th class="wide" <%-- Sortable="true"
                                 Direction="Asc" --%> id="second">Second</th>
        </tr>
    </table>
</body>
</html>
