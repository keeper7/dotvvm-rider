@viewModel SampleApp.ViewModels.DifferentlyNamedViewModel, SampleApp

<!DOCTYPE html>
<html>
<head><title>Sample</title></head>
<body>
    <dot:TextBox Text="{value: Name}" />
    <dot:Repeater DataSource="{value: Items.Where(x => x.Id > 0).Select(x => new { A = x.Name })}">
        <ItemTemplate>
            <span>{{value: A}}</span>
        </ItemTemplate>
    </dot:Repeater>
    <dot:Button Text="{resource: Labels.Save}" Click="{command: Save()}" />
    <span>{value: Format("}")}</span>
    <cc:MyControl Value="{value: Name}" />
    <div class="not-a-binding">{ this is not a binding }</div>

    <%-- A whole element switched off. The tag inside must not be validated. --%>
    <table>
        <tr>
            <th <%-- width="30%" --%>>{{resource: Labels.Save}}</th>
            <th class="wide" <%-- Sortable="true"
                                 Direction="Asc" --%> id="second">Second</th>
        </tr>
    </table>
</body>
</html>
