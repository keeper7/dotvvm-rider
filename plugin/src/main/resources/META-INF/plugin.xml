<idea-plugin>
  <id>com.keeper7.dotvvm</id>
  <name>DotVVM</name>
  <vendor url="https://github.com/keeper7">keeper7</vendor>
  <description><![CDATA[
    DotVVM support for JetBrains Rider — syntax highlighting, navigation and validation
    for .dothtml, .dotmaster and .dotcontrol files.
  ]]></description>

  <!-- Shown by Marketplace for this release; the details live in CHANGELOG.md -->
  <change-notes><![CDATA[
    <h3>0.1.0</h3>
    <ul>
      <li>Highlighting for binding expressions, including nested braces and quotes inside the expression</li>
      <li>Directives: highlighting, name completion, navigation to the master page</li>
      <li>Tag validation, control completion and navigation to the view model from the directive</li>
      <li>A status bar indicator naming what the language server knows about the project</li>
      <li>Suppression of messages the platform reports only because it does not know DotVVM</li>
    </ul>
  ]]></change-notes>

  <depends>com.intellij.modules.xml</depends>
  <!-- LSP API není v Community edici; bez tohoto modulu se plugin nenačte -->
  <depends>com.intellij.modules.lsp</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="DotVVM Page" language="DotVVM" extensions="dothtml"
              implementationClass="com.keeper7.dotvvm.lang.DotHtmlFileType" fieldName="INSTANCE"/>
    <fileType name="DotVVM User Control" language="DotVVM" extensions="dotcontrol"
              implementationClass="com.keeper7.dotvvm.lang.DotControlFileType" fieldName="INSTANCE"/>
    <fileType name="DotVVM Master Page" language="DotVVM" extensions="dotmaster"
              implementationClass="com.keeper7.dotvvm.lang.DotMasterFileType" fieldName="INSTANCE"/>

    <lang.parserDefinition language="DotVVM"
                           implementationClass="com.keeper7.dotvvm.lang.DotvvmParserDefinition"/>

    <lang.parserDefinition language="DotVVMBinding"
                           implementationClass="com.keeper7.dotvvm.binding.BindingParserDefinition"/>

    <multiHostInjector implementation="com.keeper7.dotvvm.binding.BindingInjector"/>

    <lang.syntaxHighlighterFactory language="DotVVM"
                                   implementationClass="com.keeper7.dotvvm.lang.DotvvmSyntaxHighlighterFactory"/>

    <lang.syntaxHighlighterFactory language="DotVVMBinding"
                                   implementationClass="com.keeper7.dotvvm.binding.BindingHighlighterFactory"/>
    <platform.lsp.integrationProvider
        implementation="com.keeper7.dotvvm.lsp.DotvvmLspIntegrationProvider"/>

    <statusBarWidgetFactory id="DotvvmConfigurationTier"
                            implementation="com.keeper7.dotvvm.lsp.DotvvmStatusBarWidgetFactory"/>

    <lang.inspectionSuppressor language="DotVVM"
                               implementationClass="com.keeper7.dotvvm.ide.DotvvmInspectionSuppressor"/>

    <completion.contributor language="DotVVM" order="first"
                            implementationClass="com.keeper7.dotvvm.directive.DirectiveCompletionContributor"/>

    <highlightErrorFilter
        implementation="com.keeper7.dotvvm.directive.DirectiveErrorFilter"/>

    <annotator language="DotVVM"
               implementationClass="com.keeper7.dotvvm.directive.DirectiveAnnotator"/>

    <gotoDeclarationHandler
        implementation="com.keeper7.dotvvm.directive.MasterPageNavigationHandler"/>

    <additionalTextAttributes scheme="Default" file="colorSchemes/DotvvmDefault.xml"/>
  </extensions>
</idea-plugin>
