<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DotVVM.LanguageServer.Probe</RootNamespace>
    <!--
      Overrides TargetFramework from Directory.Build.props. The probe must run on a runtime at
      least as new as the target project: a net8.0 host cannot load an assembly targeting net9.0
      (it rejects System.Runtime 9.0.0.0). The server therefore picks the variant by the target
      assembly's runtimeconfig.json.
    -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotVVM" Version="4.3.17" />
  </ItemGroup>

  <!--
    Target projects are ASP.NET Core applications and their types reference
    Microsoft.AspNetCore.*. Those live in the shared framework, not in NuGet packages, so
    AssemblyDependencyResolver cannot find them. Without this reference the probe fails with
    a "Could not load Microsoft.AspNetCore.Mvc.RazorPages".
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
