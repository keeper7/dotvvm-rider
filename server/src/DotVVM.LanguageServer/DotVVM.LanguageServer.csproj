<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DotVVM.LanguageServer</RootNamespace>

    <!--
      Runs on a newer .NET than it was built against. The default policy is Minor, which never
      crosses a major version: built as net8.0, the server asks for 8.0.0 and a machine carrying
      only .NET 9 fails with "The framework 'Microsoft.NETCore.App', version '8.0.0' was not
      found" - and the user sees nothing but an empty status bar, since the plugin itself loads
      either way.

      Measured with DOTNET_ROLL_FORWARD=LatestMajor: the server starts on 9.0.14 with nothing on
      stderr, so what stopped it was the policy, not the code. .NET 8 leaves support in November
      2026, which makes a machine with only a newer one the ordinary case rather than the odd one.

      This belongs to the server alone. The view compiler is started with the target
      application's own runtimeconfig and follows its policy, and the probe is built for each
      framework separately - both go by the user's project, which is the point of them.
    -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
  </ItemGroup>

  <!--
    The probe builds into the probe/ subdirectory next to the server, where it is found by
    AssemblyProbeSource.DefaultProbePath(). ReferenceOutputAssembly=false,
    because the probe runs as a separate process and is not linked.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DotVVM.LanguageServer.Probe\DotVVM.LanguageServer.Probe.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      OutputItemType="none" />
  </ItemGroup>

  <!--
    Copies every TFM variant of the probe, so the result is probe/net8.0/… and probe/net9.0/….
    AssemblyProbeSource composes the path to the right one at run time.
  -->
  <Target Name="CopyProbeOutput" AfterTargets="Build">
    <ItemGroup>
      <ProbeFiles Include="$(MSBuildThisFileDirectory)..\DotVVM.LanguageServer.Probe\bin\$(Configuration)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProbeFiles)"
          DestinationFiles="@(ProbeFiles->'$(OutputPath)probe\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
